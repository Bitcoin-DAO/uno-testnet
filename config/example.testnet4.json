{
  "configVersion": 1,
  "stage": "testnet",
  "name": "UNO",
  "description": "The first DAO built with btc-dao: a trial on testnet4. Proof of concept.",
  "languages": ["it", "en"],
  "network": "testnet4",
  "site": "https://bitcoin-dao.github.io/uno-testnet",
  "passkeyDomain": "bitcoin-dao.github.io",
  "council": [
    { "label": "Council 1", "identityKey": "[npub]", "fingerprint": "[8 hex]", "xpub": "[tpub at m/48'/1'/0'/2']" },
    { "label": "Council 2", "identityKey": "[npub]", "fingerprint": "[8 hex]", "xpub": "[tpub at m/48'/1'/0'/2']" },
    { "label": "Council 3", "identityKey": "[npub]", "fingerprint": "[8 hex]", "xpub": "[tpub at m/48'/1'/0'/2']" },
    { "label": "Council 4", "identityKey": "[npub]", "fingerprint": "[8 hex]", "xpub": "[tpub at m/48'/1'/0'/2']" },
    { "label": "Council 5", "identityKey": "[npub]", "fingerprint": "[8 hex]", "xpub": "[tpub at m/48'/1'/0'/2']" }
  ],
  "founders": [
    { "name": "[pseudonym]", "identityKey": "[npub]", "verified": "in_person" },
    { "name": "[pseudonym]", "identityKey": "[npub]", "verified": "remote" }
  ],
  "threshold": 3,
  "descriptor": "wsh(sortedmulti(3,[fp1/48h/1h/0h/2h]tpub1/<0;1>/*,[fp2/48h/1h/0h/2h]tpub2/<0;1>/*,[fp3/48h/1h/0h/2h]tpub3/<0;1>/*,[fp4/48h/1h/0h/2h]tpub4/<0;1>/*,[fp5/48h/1h/0h/2h]tpub5/<0;1>/*))#[checksum]",
  "relays": ["wss://btc-dao-relay.btcdao.workers.dev", "wss://[public relay 1]", "wss://[public relay 2]"],
  "chainApi": ["https://mempool.space/testnet4/api", "blockbook:https://blockbook.tbtc.zelcore.io"],
  "rules": {
    "votingPeriodDays": 7,
    "quorum": "1/3",
    "simpleMajority": ["payout", "statement", "addMember"],
    "twoThirdsMajority": ["removeMember", "changeRules", "changeCouncil", "close"],
    "payoutRound": "monthly",
    "timezone": "Europe/Rome",
    "lapseAfterRounds": 2,
    "maxFeeRateSatVb": 20,
    "treasuryCapSats": 5000000,
    "remoteVerification": { "councilMembersOnCall": 2, "remoteMembersMayJoinCouncil": false, "maxRemoteShare": null },
    "minimumAge": 18,
    "fundingModel": "[grant | production | mutual | revolving]",
    "charterLanguage": "it",
    "charterSha256": "[sha256 of the Italian charter text]"
  },
  "testnetTreasury": { "name": "BTC DAO Testnet Treasury", "address": "[testnet4 address]" },
  "branding": { "logo": null, "colours": { "ink": "#10292E", "accent": "#B54D0A", "teal": "#1F6B70" } }
}
